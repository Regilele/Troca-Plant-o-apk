{
  "name": "rgsa-plantao",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "RG&SA PLANTÃO — escala e troca de plantões (web app + PWA), reconstruído a partir do APK original sem perda de dados.",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node --watch server/index.js\" \"vite --config client/vite.config.ts\"",
    "build": "vite build --config client/vite.config.ts",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "db:reset": "node server/scripts/reset-db.js",
    "db:backup": "node server/scripts/backup.js",
    "test:visual": "node tests/visual.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "framer-motion": "^12.23.12",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
